GEMINI_API_KEY=your_gemini_api_key_here
# Vertex AI is tried first when GOOGLE_CLOUD_PROJECT is set.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_GEMINI_MODEL=gemini-3.5-flash-lite
VERTEX_TIMEOUT_MS=12000
# Server-side only on Vercel: paste the complete service-account JSON as one env value.
# Locally, prefer `gcloud auth application-default login` instead.
# VERTEX_SERVICE_ACCOUNT_JSON=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=12000
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_REQUEST_BYTES=12500000
HOMERUAI_DATA_DIR=./data
# 公開時だけ設定。Turso の libSQL データベースを使用する。
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your_turso_token_here
